```xml
    <?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131129">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#201B42"
            app:titleTextColor="@android:color/white"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="iCAFE EDGE"
                android:textColor="#00F2FE"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:text="Client Self-Service Portal"
                android:textColor="#A0A0C0"
                android:textSize="14sp" />

            <Button
                android:backgroundTint="#201B42"
                android:id="@+id/btnBooking"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:text="Booking Kamar PC"
                android:textColor="#FFFFFF" />

            <Button
                android:backgroundTint="#201B42"
                android:id="@+id/btnKantin"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:text="Makanan dan Minuman"
                android:textColor="#FFFFFF" />

            <Button
                android:backgroundTint="#00E676"
                android:id="@+id/btnWebView"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:text="Portal Member iCafe"
                android:textColor="#000000"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconGravity="textStart" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
